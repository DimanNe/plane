+"use client";
+import { useState } from "react";
+//#region fork: final focus of the focus before open
+/**
+* Whether the focus goes back when a dialog closes. Base UI's default goes back to the element that had the focus when
+* the dialog opened, but where that was the page itself, as for a dialog that a key shortcut opens, it falls back to
+* the last element focused anywhere before, kept across all popups: a control far from what the person was doing,
+* such as the workspace switcher, which then opened its menu on the next arrow key. In that case the focus stays on
+* the page, so the keys that follow are the page's again; otherwise Base UI's default applies, with its rule that a
+* focus that has moved on elsewhere meanwhile is left there. That rule holds only for `true` itself, not for a
+* function, hence a value fixed as the dialog's content first renders, which is before Base UI moves the focus into it.
+*/
+function useFinalFocusOfFocusBeforeOpen() {
+	const [focusBeforeOpen] = useState(() => typeof document === "undefined" ? void 0 : document.activeElement);
+	return focusBeforeOpen === void 0 || (focusBeforeOpen !== null && focusBeforeOpen !== document.body);
+}
+//#endregion
+export { useFinalFocusOfFocusBeforeOpen };
